{
  "uid": "nowline-operations",
  "title": "Nowline · Operations",
  "description": "Actual Spring JVM and Kubernetes container measurements from the Linux kind node. This does not measure macOS hardware. Logs are sanitized before ingestion. Empty series indicate missing instrumentation, not a zero reading.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "tags": ["nowline", "operations", "linux-kind"],
  "timezone": "browser",
  "links": [{"title": "Explore server logs", "type": "link", "url": "/ops/grafana/explore?schemaVersion=1&panes=%7B%22logs%22%3A%7B%22datasource%22%3A%22nowline-loki%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22expr%22%3A%22%7Bnamespace%3D%5C%22nowline-local%5C%22%7D%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22now-1h%22%2C%22to%22%3A%22now%22%7D%7D%7D"}],
  "templating": {"list": []},
  "panels": [
    {"id": 1, "type": "stat", "title": "Backend scrape health", "datasource": {"type": "prometheus", "uid": "nowline-prometheus"}, "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4}, "fieldConfig": {"defaults": {"min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}, "targets": [{"refId": "A", "expr": "min(up{job=\"nowline-backend\"})", "instant": true}]},
    {"id": 2, "type": "stat", "title": "API requests / second", "datasource": {"type": "prometheus", "uid": "nowline-prometheus"}, "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4}, "targets": [{"refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{job=\"nowline-backend\",uri!~\"/actuator/.*\"}[5m]))", "instant": true}]},
    {"id": 3, "type": "stat", "title": "API 5xx fraction", "datasource": {"type": "prometheus", "uid": "nowline-prometheus"}, "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4}, "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []}, "targets": [{"refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{job=\"nowline-backend\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"nowline-backend\"}[5m])), 0.001)", "instant": true}]},
    {"id": 4, "type": "stat", "title": "Firing alerts (dashboard only)", "datasource": {"type": "prometheus", "uid": "nowline-prometheus"}, "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4}, "targets": [{"refId": "A", "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)", "instant": true}]},
    {"id": 5, "type": "timeseries", "title": "Kubernetes container CPU · cores", "description": "CPU consumed by each Nowline container in the Linux kind node, not a macOS CPU percentage.", "datasource": {"type": "prometheus", "uid": "nowline-prometheus"}, "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "cores", "min": 0}, "overrides": []}, "targets": [{"refId": "A", "expr": "sum by (pod, container) (rate(container_cpu_usage_seconds_total{job=\"kind-kubelet\",namespace=\"nowline-local\",container!=\"\",container!=\"POD\"}[5m]))", "legendFormat": "{{pod}} / {{container}}"}]},
    {"id": 6, "type": "timeseries", "title": "Kubernetes container working-set memory", "datasource": {"type": "prometheus", "uid": "nowline-prometheus"}, "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}, "overrides": []}, "targets": [{"refId": "A", "expr": "sum by (pod, container) (container_memory_working_set_bytes{job=\"kind-kubelet\",namespace=\"nowline-local\",container!=\"\",container!=\"POD\"})", "legendFormat": "{{pod}} / {{container}}"}]},
    {"id": 7, "type": "timeseries", "title": "JVM heap used / maximum", "datasource": {"type": "prometheus", "uid": "nowline-prometheus"}, "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}, "overrides": []}, "targets": [{"refId": "A", "expr": "sum by (pod) (jvm_memory_used_bytes{job=\"nowline-backend\",area=\"heap\"})", "legendFormat": "{{pod}} used"}, {"refId": "B", "expr": "sum by (pod) (jvm_memory_max_bytes{job=\"nowline-backend\",area=\"heap\"} > 0)", "legendFormat": "{{pod}} maximum"}]},
    {"id": 8, "type": "timeseries", "title": "JVM process CPU utilization", "datasource": {"type": "prometheus", "uid": "nowline-prometheus"}, "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}, "overrides": []}, "targets": [{"refId": "A", "expr": "process_cpu_usage{job=\"nowline-backend\"}", "legendFormat": "{{pod}}"}]},
    {"id": 9, "type": "timeseries", "title": "GC pause seconds / second", "datasource": {"type": "prometheus", "uid": "nowline-prometheus"}, "gridPos": {"x": 0, "y": 20, "w": 8, "h": 7}, "targets": [{"refId": "A", "expr": "sum by (pod) (rate(jvm_gc_pause_seconds_sum{job=\"nowline-backend\"}[5m]))", "legendFormat": "{{pod}}"}]},
    {"id": 10, "type": "timeseries", "title": "DB pool active / pending connections", "datasource": {"type": "prometheus", "uid": "nowline-prometheus"}, "gridPos": {"x": 8, "y": 20, "w": 8, "h": 7}, "targets": [{"refId": "A", "expr": "hikaricp_connections_active{job=\"nowline-backend\"}", "legendFormat": "{{pod}} active"}, {"refId": "B", "expr": "hikaricp_connections_pending{job=\"nowline-backend\"}", "legendFormat": "{{pod}} pending"}]},
    {"id": 11, "type": "timeseries", "title": "Linux kind node running containers", "description": "Kubelet count inside the Linux kind node. It is not the macOS host process count.", "datasource": {"type": "prometheus", "uid": "nowline-prometheus"}, "gridPos": {"x": 16, "y": 20, "w": 8, "h": 7}, "targets": [{"refId": "A", "expr": "sum by (node) (kubelet_running_containers{job=\"kind-node\"})", "legendFormat": "{{node}}"}]},
    {"id": 12, "type": "timeseries", "title": "Observability memory overhead", "datasource": {"type": "prometheus", "uid": "nowline-prometheus"}, "gridPos": {"x": 0, "y": 27, "w": 12, "h": 7}, "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}, "targets": [{"refId": "A", "expr": "sum by (container) (container_memory_working_set_bytes{namespace=\"nowline-observability\",container!=\"\",container!=\"POD\"})", "legendFormat": "{{container}}"}]},
    {"id": 13, "type": "timeseries", "title": "Persistent volume capacity used", "description": "Some kind local-path storage providers do not export volume statistics. Empty data needs a kubectl exec df check; it is not zero usage.", "datasource": {"type": "prometheus", "uid": "nowline-prometheus"}, "gridPos": {"x": 12, "y": 27, "w": 12, "h": 7}, "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []}, "targets": [{"refId": "A", "expr": "1 - kubelet_volume_stats_available_bytes{namespace=\"nowline-observability\"} / kubelet_volume_stats_capacity_bytes{namespace=\"nowline-observability\"}", "legendFormat": "{{persistentvolumeclaim}}"}]},
    {"id": 14, "type": "logs", "title": "Sanitized server warnings and errors", "description": "Sensitive credential/header lines are dropped; query strings and JWTs are redacted. Full server messages and stack frames remain when safe. Open Explore for info logs.", "datasource": {"type": "loki", "uid": "nowline-loki"}, "gridPos": {"x": 0, "y": 34, "w": 24, "h": 13}, "options": {"showTime": true, "showLabels": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true}, "targets": [{"refId": "A", "expr": "{namespace=\"nowline-local\",level=~\"error|warn\"} | json | line_format \"{{.message}}\"", "queryType": "range"}]}
  ]
}
