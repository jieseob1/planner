<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.goalstotoday.tunnel</string>
  <key>UserName</key>
  <string>__NOWLINE_SERVICE_USER__</string>
  <key>WorkingDirectory</key>
  <string>__NOWLINE_REPO_DIR__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NOWLINE_REPO_DIR__/scripts/mac-mini-goalstotoday-tunnel.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__NOWLINE_SERVICE_HOME__</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
