    <string>922b16b2-307d-45e4-acff-cf864353ba38</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__NOWLINE_SERVICE_HOME__/.cloudflared/logs/goalstotoday.out.log</string>
  <key>StandardErrorPath</key>
  <string>__NOWLINE_SERVICE_HOME__/.cloudflared/logs/goalstotoday.err.log</string>
