{
  "name": "planner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest",
    "test:run": "vitest run",
    "verify:unit": "vitest run && node scripts/success.mjs \"frontend tests passed\"",
    "verify:structure": "node scripts/verify-structure.mjs",
    "verify:design-source": "node scripts/verify-design-source.mjs",
    "verify:visual-system": "node scripts/verify-visual-system.mjs",
    "verify:landing": "vitest run src/screens/LandingScreen.test.tsx && node scripts/verify-landing-page.mjs",
    "verify:usability": "vitest run && node scripts/verify-usability.mjs",
    "verify:build": "npm run build && node scripts/verify-build.mjs",
    "verify:mobile": "npm run build && cap sync && node scripts/verify-mobile.mjs",
    "verify:release": "npm run verify:unit && npm run verify:structure && npm run verify:design-source && npm run verify:visual-system && npm run verify:usability && npm run verify:build && npm run verify:mobile && node scripts/success.mjs \"redesigned frontend release verification passed\"",
    "verify:backend": "cd backend && ./mvnw -q verify && node ../scripts/success.mjs \"backend verification passed\"",
    "verify:k8s": "node scripts/verify-k8s.mjs && node scripts/verify-k8s-production.mjs",
    "verify:k8s:runtime": "scripts/k8s-local.sh up && scripts/k8s-local.sh verify && node scripts/verify-k8s-scaleout.mjs",
    "verify:e2e": "node scripts/verify-backend-e2e.mjs",
    "verify:migration": "node scripts/verify-migration-runner.mjs",
    "verify:recovery": "node scripts/verify-recovery.mjs",
    "verify:production:e2e": "node scripts/verify-production-e2e.mjs",
    "verify:production:reliability": "node scripts/verify-production-reliability.mjs",
    "verify:mysql-contract": "node scripts/verify-mysql-contract.mjs",
    "verify:production:contracts": "node scripts/verify-production-contracts.mjs && npm run verify:mysql-contract",
    "verify:secrets": "node scripts/verify-secrets.mjs",
    "verify:dependencies": "npm audit --audit-level=moderate",
    "verify:production": "npm run verify:full && npm run verify:production:e2e && npm run verify:production:reliability && npm run verify:migration && npm run verify:recovery && npm run verify:production:contracts && npm run verify:dependencies && npm run verify:secrets && node scripts/success.mjs \"production repository verification passed\"",
    "verify:beta": "node scripts/verify-local-beta-contracts.mjs && npm run verify:release && npm run verify:backend && node scripts/success.mjs \"local beta implementation verified\"",
    "verify:beta:runtime": "scripts/local-beta.sh verify",
    "verify:beta:backup": "node scripts/verify-local-beta-backup.mjs",
    "verify:beta:k8s": "node scripts/verify-local-beta-k8s.mjs",
    "verify:beta:k8s:runtime": "NOWLINE_K8S_SKIP_BUILD=true node scripts/verify-local-beta-k8s.mjs",
    "verify:goalstotoday:contracts": "node scripts/verify-goalstotoday-contracts.mjs",
    "verify:goalstotoday:release": "npm run verify:goalstotoday:contracts && npm run verify:release && npm run verify:backend && npm run verify:k8s && node scripts/success.mjs \"Goals to Today repository release verification passed\"",
    "verify:goalstotoday:public": "node scripts/verify-goalstotoday-public.mjs",
    "verify:goalstotoday:mac-mini": "node scripts/verify-goalstotoday-mac-mini.mjs",
    "verify:goalstotoday:deployment": "node scripts/verify-goalstotoday-deployment.mjs",
    "capture:goalstotoday:screenshots": "node scripts/capture-goalstotoday-screenshots.mjs",
    "capture:goalstotoday:product-screenshots": "node scripts/capture-goalstotoday-product-screenshots.mjs",
    "verify:full": "npm run verify:release && npm run verify:backend && npm run verify:k8s && npm run verify:e2e && node scripts/success.mjs \"full stack verification passed\"",
    "dev:backend": "cd backend && ./mvnw spring-boot:run",
    "dev:stack": "make compose-up",
    "beta:prepare": "scripts/local-beta.sh prepare",
    "beta:up": "scripts/local-beta.sh up",
    "beta:status": "scripts/local-beta.sh status",
    "beta:logs": "scripts/local-beta.sh logs",
    "beta:down": "scripts/local-beta.sh down",
    "beta:backup": "scripts/backup-local-mysql.sh",
    "k8s:up": "scripts/k8s-local.sh up",
    "k8s:verify": "scripts/k8s-local.sh verify",
    "k8s:serve": "scripts/k8s-beta-server.sh start",
    "k8s:serve:status": "scripts/k8s-beta-server.sh status",
    "k8s:serve:stop": "scripts/k8s-beta-server.sh stop",
    "k8s:down": "scripts/k8s-local.sh down",
    "cap:sync": "npm run build && cap sync",
    "app:ios": "npm run cap:sync && cap open ios",
    "app:android": "npm run cap:sync && cap open android"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/push-notifications": "^8.1.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.37.0",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "playwright-core": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
