# Web development: leave empty so Vite proxies /api to http://localhost:8080.
VITE_API_BASE_URL=

# Native builds cannot use the Vite development proxy. Build each target with
# a directly reachable backend origin (no trailing slash), for example:
# iOS Simulator on the same Mac: http://localhost:8080
# Android Emulator:             http://10.0.2.2:8080
# Physical device / production: use an HTTPS API origin reachable by the device.

# Local-development identity only. This header is not production authentication.
VITE_NOWLINE_USER_ID=00000000-0000-4000-8000-000000000001
