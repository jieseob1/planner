# Web development: leave empty so Vite proxies /api to http://localhost:8080.
VITE_API_BASE_URL=

# Native builds cannot use the Vite development proxy. Build each target with
# a directly reachable backend origin (no trailing slash), for example:
# iOS Simulator on the same Mac: http://localhost:8080
# Android Emulator:             http://10.0.2.2:8080
# Physical device / production: use an HTTPS API origin reachable by the device.

# Local development uses the backend's local-auth profile. Native and public
# web builds must use OIDC Authorization Code + PKCE.
VITE_AUTH_MODE=local
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_SCOPE=openid profile email offline_access
VITE_OIDC_WEB_REDIRECT_URI=https://app.nowline.example/auth/callback
VITE_OIDC_WEB_POST_LOGOUT_REDIRECT_URI=https://app.nowline.example
VITE_OIDC_NATIVE_REDIRECT_URI=com.jieseob.planner://auth/callback
VITE_OIDC_NATIVE_POST_LOGOUT_REDIRECT_URI=com.jieseob.planner://auth/logout
VITE_OIDC_SILENT_REDIRECT_URI=https://app.nowline.example/auth/silent-callback
